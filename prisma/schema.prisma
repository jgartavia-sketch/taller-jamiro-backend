generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum PointMovementType {
  PURCHASE
  REFERRAL
  ADJUSTMENT
  REDEMPTION
  REVERSAL
}

enum UsedPartRequestStatus {
  PENDING
  CONTACTED
  QUOTED
  CLOSED
  CANCELLED
}

enum ServiceRequestStatus {
  PENDING
  CONTACTED
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum WorkshopStatus {
  RECEIVED
  DIAGNOSIS
  IN_PROGRESS
  WAITING_PARTS
  QUALITY_CHECK
  READY
  DELIVERED
  CANCELLED
}

model User {
  id                   String          @id @default(uuid())
  customerCode         String          @unique
  name                 String
  email                String          @unique
  phone                String
  passwordHash         String
  role                 UserRole        @default(CUSTOMER)
  purchasePoints       Int             @default(0)
  referralPoints       Int             @default(0)
  referralCount        Int             @default(0)
  referredById         String?
  referredBy           User?           @relation("UserReferrals", fields: [referredById], references: [id])
  referredUsers        User[]          @relation("UserReferrals")
  referralCodes        ReferralCode[]  @relation("CodeOwner")
  redeemedReferralCode ReferralCode?   @relation("CodeRedeemer")
  pointMovements       PointMovement[]
  vehicles             Vehicle[]
  serviceOrders        ServiceOrder[]
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  @@index([createdAt])
}

model StaffAccount {
  id             String          @id @default(uuid())
  name           String
  email          String          @unique
  passwordHash   String
  active         Boolean         @default(true)
  pointMovements PointMovement[]
  createdOrders  ServiceOrder[]  @relation("OrderCreator")
  serviceUpdates ServiceUpdate[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([active])
}

model ReferralCode {
  id         String   @id @default(uuid())
  code       String   @unique
  ownerId    String
  owner      User     @relation("CodeOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  usedAt     DateTime?
  usedById   String?  @unique
  usedBy     User?    @relation("CodeRedeemer", fields: [usedById], references: [id])
  createdAt  DateTime @default(now())

  @@index([ownerId, expiresAt])
}

model PointMovement {
  id               String            @id @default(uuid())
  userId           String
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  type             PointMovementType
  points           Int
  amountColones    Int?
  description      String
  referenceId      String?           @unique
  invoiceNumber    String?           @unique
  createdByStaffId String?
  createdByStaff   StaffAccount?     @relation(fields: [createdByStaffId], references: [id], onDelete: SetNull)
  createdAt        DateTime          @default(now())

  @@index([userId, createdAt])
  @@index([createdByStaffId, createdAt])
}

model UsedPartRequest {
  id        String                @id @default(uuid())
  name      String
  brand     String
  model     String
  year      String
  part      String
  details   String?
  status    UsedPartRequestStatus @default(PENDING)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  @@index([status, createdAt])
}

model ServiceRequest {
  id            String               @id @default(uuid())
  name          String
  brand         String
  model         String
  year          String
  service       String
  problem       String
  preferredDate DateTime?
  status        ServiceRequestStatus @default(PENDING)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([status, createdAt])
}

model Vehicle {
  id            String         @id @default(uuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  plate         String
  brand         String
  model         String
  year          String
  color         String
  serviceOrders ServiceOrder[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([userId, plate])
  @@index([plate])
}

model ServiceOrder {
  id                String          @id @default(uuid())
  orderCode         String          @unique
  customerId        String
  customer          User            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  vehicleId         String
  vehicle           Vehicle         @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  mileage           Int
  fuelLevel         String
  reason            String
  visibleDamage     String?
  receivedItems     String?
  estimatedDelivery DateTime?
  status            WorkshopStatus  @default(RECEIVED)
  deliveredAt       DateTime?
  createdByStaffId  String
  createdByStaff    StaffAccount    @relation("OrderCreator", fields: [createdByStaffId], references: [id], onDelete: Restrict)
  updates           ServiceUpdate[]
  photos            ServicePhoto[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([customerId, status])
  @@index([status, updatedAt])
}

model ServiceUpdate {
  id               String         @id @default(uuid())
  serviceOrderId   String
  serviceOrder     ServiceOrder   @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  status           WorkshopStatus
  note             String
  createdByStaffId String
  createdByStaff   StaffAccount   @relation(fields: [createdByStaffId], references: [id], onDelete: Restrict)
  photos           ServicePhoto[]
  createdAt        DateTime       @default(now())

  @@index([serviceOrderId, createdAt])
}

model ServicePhoto {
  id             String         @id @default(uuid())
  serviceOrderId String
  serviceOrder   ServiceOrder   @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  updateId       String?
  update         ServiceUpdate? @relation(fields: [updateId], references: [id], onDelete: Cascade)
  dataUrl        String         @db.Text
  caption        String?
  createdAt      DateTime       @default(now())

  @@index([serviceOrderId, createdAt])
}